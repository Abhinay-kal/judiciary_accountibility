                                return {
                                    label: item.Label,
                                    url: item.TargetUrl
                                };
                            }));
                        }
                    });
                },

                select: function (event, ui) {
                    event.preventDefault();
                    if (ui.item.url != null)
                        window.location.href = ui.item.url;
