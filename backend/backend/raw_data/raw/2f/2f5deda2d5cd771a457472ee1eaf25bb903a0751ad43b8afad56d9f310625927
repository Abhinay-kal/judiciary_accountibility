    <script nonce="vfR6/VjAD0OXW57/qV4hLw==" type="text/javascript">
        function GetParameterValues(param) {
            var url = window.location.href.slice(window.location.href.indexOf('?') + 1).split('&');
            for (var i = 0; i < url.length; i++) {
                var urlparam = url[i].split('=');
                if (urlparam[0] == param) {
                    return urlparam[1];
                }
            }
        }
        $(function () {

            var p = parseInt(GetParameterValues('p'));

            if ((isNaN(p)))
                p = 0;
            $("#accordion").accordion({
                heightStyle: "content",
                active: p


            });

        });
        document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll(".validateBtn").forEach(function (btn) {

                btn.addEventListener("click", function (e) {

                    let activeGroup = this.dataset.group;   // grp1 or grp2

                    // Remove required from ALL
                    let allFields = document.querySelectorAll(".req");
                    allFields.forEach(f => f.removeAttribute("required"));

                    // Add required back only to active group
                    let groupFields = document.querySelectorAll("." + activeGroup);
                    groupFields.forEach(f => f.setAttribute("required", "required"));

                    // Validate only the active group
                    for (let field of groupFields) {
                        if (!field.checkValidity()) {
                            field.reportValidity();
                            e.preventDefault();
                            return; // 🔥 FIX — prevents reverse order validation
                        }
                    }

                });
            });
        });



    </script>



