  function renderCalendar(m, y) {
    const months = [
      'January', 'February', 'March', 'April', 'May', 'June', 
      'July', 'August', 'September', 'October', 'November', 'December'
    ];
    const c_date = new Date();

    let firstDay = new Date(y, m, 1).getDay();
    let d_m = new Date(y, m + 1, 0).getDate();
    let d_pm = new Date(y, m, 0).getDate();

    let table = document.getElementById('dates');
    table.innerHTML = '';
    let s_m = document.getElementById('s_m');
    s_m.innerHTML = months[m] + ' ' + y;

    let date = 1;
    let r_pm = d_pm - firstDay + 1;

    for (let i = 0; i < 6; i++) {
      let row = document.createElement('tr');

      for (let j = 0; j < 7; j++) {
        let cell = document.createElement('td');
        let span = document.createElement('span');

        if (i === 0 && j < firstDay) {
          span.classList.add('ntMonth', 'prevMonth');
          span.textContent = r_pm++;
        } else if (date > d_m) {
          span.classList.add('ntMonth', 'nextMonth');
          span.textContent = date++ - d_m;
        } else {
          let div = document.createElement('div');
          span.classList.add('showEvent');
          span.textContent = date;

          if (date === c_date.getDate() && y === c_date.getFullYear() && m === c_date.getMonth()) {
            div.classList.add('today');
          }

          specialDates.forEach((specialDate, index) => {
            if (specialDate && date === specialDate.getDate() && y === specialDate.getFullYear() && m === specialDate.getMonth()) {
              div.classList.add(specialClasses[index]);
            }
          });

          div.appendChild(span);
          cell.appendChild(div);
          date++;
        }

        if (j === 0) {
          cell.classList.add('sunday');
        } else if (j === 6) {
          cell.classList.add('saturday');
        }

        if (!span.parentNode) {
          cell.appendChild(span);
        }

        row.appendChild(cell);
      }

      table.appendChild(row);
    }
  }

function updateOpacityBg(clickedDate, clickedDay, holidaysClasses) {
  document.querySelector('.current_day span').textContent = clickedDate;
  document.querySelector('.current_day_name span').textContent = clickedDay;

  const detailsSummary = document.querySelector('.details_summary');
  detailsSummary.innerHTML = ''; // Clear previous details

  // Normalize to check for real events (ignoring <br> and html)
  const normalizedEvents = holidaysClasses.map(ev => ev.replace(/<br>.*$/, '').trim());
  const uniqueEventsSet = new Set(normalizedEvents);

  // If there are real events, show only them
  if (uniqueEventsSet.size > 0) {
    holidaysClasses.forEach((eventHTML) => {
      const li = document.createElement('li');
      li.innerHTML = `<span>${eventHTML}</span>`;
      detailsSummary.appendChild(li);
    });
  } else {
    // If no events, show weekend or working day labels
    const li = document.createElement('li');
    if (clickedDay === 'Sunday') {
      li.innerHTML = `<span>(Public Holiday)</span>`;
    } else if (clickedDay === 'Saturday') {
      const weekNumber = Math.ceil(clickedDate / 7);
      if (weekNumber === 2) {
        li.innerHTML = `<span>Second Saturday<br>(<span style="color:#fd4727 !important;">Public Holiday</span>)</span>`;
      } else if (weekNumber === 4) {
        li.innerHTML = `<span>Fourth Saturday<br>(<span style="color:#fd4727 !important;">Public Holiday</span>)</span>`;
      } else {
        li.innerHTML = `<span>Registry<br>(<span>Working Day</span>)</span>`;
      }
    } else {
      li.innerHTML = `<span>Working Day</span>`;
    }
    detailsSummary.appendChild(li);
  }
}




  document.addEventListener('DOMContentLoaded', function () {
    document.addEventListener(
      'click',
      function (e) {
        if (e.target.matches('.showEvent') && !e.target.classList.contains('prevMonth') && !e.target.classList.contains('nextMonth')) {
          const clickedDate = e.target.textContent;
          const clickedDay = days[new Date(year, month, clickedDate).getDay()];

          const clickedSpecialClasses = [];
          specialDates.forEach((specialDate, index) => {
            if (
              specialDate &&
              clickedDate == specialDate.getDate() &&
              year === specialDate.getFullYear() &&
              month === specialDate.getMonth()
            ) {
              clickedSpecialClasses.push(holidaysClasses[index]);
            }
          });

          updateOpacityBg(clickedDate, clickedDay, clickedSpecialClasses);
        }

        if (e.target.matches('.prevMonth')) {
          year = month === 0 ? year - 1 : year;
          month = month === 0 ? 11 : month - 1;
          renderCalendar(month, year);
        }

        if (e.target.matches('.nextMonth')) {
          year = month === 11 ? year + 1 : year;
          month = (month + 1) % 12;
          renderCalendar(month, year);
        }
      },
      true
    );
  });
