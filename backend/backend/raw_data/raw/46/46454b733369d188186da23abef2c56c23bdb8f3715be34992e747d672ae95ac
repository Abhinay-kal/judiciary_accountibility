	<script>
		function myrepjudmodal(elem){
			$("#repJudModal").modal({
				//backdrop: 'static',
				keyboard: false
			});
			$('#repJudModal').modal('show');
		}
		function DownloadOrdJud(elem, act){
			var filename 	= $(elem).attr('data-filename');
			var fileyear	= $(elem).attr('data-fileyear');
			var loc			= $(elem).attr('data-loc');
			var ftype		= 'PDF';
			
			$('#loading').show();
			//$('.close-icon-css').show();
			request = $.ajax ({
				type: 'post',
				evalScripts: true,
				url:'https://hcraj.nic.in/'+loc+'/DwonloadOrdJud.php',
				data:'filename='+btoa(filename)+'&fileyear='+btoa(fileyear),
				success:function(data){
					if(data != 'NAN'){
						
						var linkurl = '';
						
						if(act == 'V')
						{
							linkurl = 'https://hcraj.nic.in/cishcraj-jp/pdfjs-dist/web/viewer.php?file=https://hcraj.nic.in/'+loc+'/'+data;
							$('.downloadFile').removeAttr('download');
						}
						
						
						$('.downloadFile').attr('href',linkurl);
						
						//$('.downloadFile').get(0).click();
						var element = document.getElementById('downloadFile');
						var eventObj = document.createEvent('MouseEvents');
						eventObj.initEvent('click',true,true);
						element.dispatchEvent(eventObj);
					}
					else{
						alert('Order/Judgement could not be downloaded at this moment. Please try again after some time.');
					}
					$('#loading').hide();
					$('.close-icon-css').hide();
				}			
			});
		}
		
		function viewAllRepJudgments(estt) {
			window.open('repJudgments.php?estt=' + estt, '_blank');
		}
	</script>
	
	
