# Backend
APP_NAME=Court Case Delay & Justice Tracker
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/justice_tracker
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
SCRAPER_RATE_LIMIT_SECONDS=1.0
SCRAPER_MAX_RETRIES=3

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
