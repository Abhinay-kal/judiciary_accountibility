# Backend
APP_NAME=Court Case Delay & Justice Tracker
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/justice_tracker
REDIS_URL=redis://redis:6379/0
DB_PORT=55433
LOG_LEVEL=INFO
SCRAPER_RATE_LIMIT_SECONDS=1.0
SCRAPER_MAX_RETRIES=3
SCRAPER_CONCURRENCY=5
CACHE_TTL_SECONDS=60
RATE_LIMIT_PER_MINUTE=120
DEFAULT_OUTCOME_CONFIDENCE_VERIFY=0.60
OUTCOME_PARSER_VERSION=outcome-rules-v1
JUDGE_MATCH_LEVENSHTEIN_THRESHOLD=0.18
JUDGE_MATCH_CONFIDENCE_THRESHOLD=0.6
ENABLE_JUDGE_ML_MATCHER=false
JUDGE_PROVISIONAL_RETENTION_DAYS=365
JUDGE_ATRIBUTION_BATCH_SIZE=500
JUDGE_ATTRIBUTION_BATCH_SIZE=500

# ── ML Module (optional) ────────────────────────────────────────────────────
# Set ML_ENABLED=false to disable all ML features without code changes.
ML_ENABLED=true
ML_PARSER_ENABLED=false
# Minimum number of disposed cases needed for real model training.
# Below this threshold the system uses a simpler median-lookup baseline.
ML_MIN_CASES=500
# Delay severity thresholds (delay_ratio = current_age / predicted_duration)
ML_DELAY_THRESHOLD_MODERATE=1.5
ML_DELAY_THRESHOLD_SEVERE=2.0
ML_DELAY_THRESHOLD_EXTREME=3.0
# Filesystem path (relative to the backend working directory) for model artifacts
ML_ARTIFACTS_DIR=app/ml/artifacts
ML_PARSER_ARTIFACT_NAME=hearing_outcome_model.pkl
ML_PARSER_REPORT_NAME=hearing_outcome_evaluation.json
# Quantile bounds for uncertainty estimation (lower and upper PI)
ML_QUANTILE_LOWER=0.1
ML_QUANTILE_UPPER=0.9

# Resilient Ingestion Module
INGEST_FAILURE_THRESHOLD=5
INGEST_ALERT_THRESHOLD_HOURS=4.0
INGEST_CONFIDENCE_MIN=0.60
INGEST_OUTCOME_OTHER_ALERT_RATIO=0.25
INGEST_OUTCOME_LOW_CONFIDENCE_ALERT_RATIO=0.20
INGEST_JUDGE_MISSING_ALERT_RATIO=0.15
INGEST_JUDGE_LOW_CONFIDENCE_ALERT_RATIO=0.20
INGEST_VOLUME_ANOMALY_RATIO=0.50
INGEST_RETRY_LIMIT=3
INGEST_BACKOFF_BASE_SECONDS=60
INGEST_SCHEMA_MISMATCH_THRESHOLD=0.20
INGEST_MAX_RAW_PAYLOAD_MB=50
INGEST_RAW_STORAGE_DIR=backend/raw_data
INGEST_CHECKPOINT_DIR=backend/raw_data/checkpoints
INGEST_ALERT_EMAIL_TO=
INGEST_ALERT_SMTP_HOST=localhost
INGEST_ALERT_SMTP_PORT=25
INGEST_ALERT_SMTP_USER=
INGEST_ALERT_SMTP_PASSWORD=
INGEST_ALERT_EMAIL_FROM=alerts@justice-tracker.local
INGEST_ALERT_SMTP_TLS=false
INGEST_ALERT_WEBHOOK_URL=
INGEST_SCHEDULER_INTERVAL_MINUTES=5
INGEST_REALERT_BASE_MINUTES=30
INGEST_REALERT_MAX_MINUTES=720

# Cost / resilience feature flags
DELTA_FETCH_ENABLED=true
CAS_ENABLED=true
LIFECYCLE_HOT_DAYS=30
LIFECYCLE_WARM_DAYS=90
MANUAL_INGEST_ENABLED=true
INGEST_ALERT_HOURS=24

# Importance scoring
IMPORTANCE_WEIGHTS_JSON=
IMPORTANCE_MIN_CONFIDENCE=0.20
IMPORTANCE_MEDIA_DECAY_LAMBDA=0.05
IMPORTANCE_MONETARY_CAP=50000000
IMPORTANCE_MIN_CASE_SIGNALS=2
IMPORTANCE_FASTPASS_ENABLED=true
IMPORTANCE_DAILY_BATCH_SIZE=1000

# Baseline-adjusted delay analytics
DELAY_BASELINE_WINDOW_YEARS=7
DELAY_MIN_GROUP_SAMPLE_SIZE=20
DELAY_USE_TIME_WEIGHTED_BASELINE=false
DELAY_HALF_LIFE_DAYS=730
DELAY_UPDATE_BATCH_SIZE=2000
DELAY_PERCENTILE_ANOMALY_THRESHOLD=90
DELAY_ROBUST_Z_ANOMALY_THRESHOLD=2
DELAY_RATIO_MODERATE_THRESHOLD=1.5
DELAY_RATIO_HIGH_THRESHOLD=2.0
DELAY_RATIO_EXTREME_THRESHOLD=3.0

# Survival analysis
SURVIVAL_WINDOW_YEARS=10
SURVIVAL_MIN_SAMPLE_SIZE=25
SURVIVAL_RECOMPUTE_BATCH_SIZE=5000
SURVIVAL_PREDICTION_HORIZON_DAYS=1825
SURVIVAL_UNUSUAL_PERCENTILE_THRESHOLD=90
SURVIVAL_LOW_PROBABILITY_THRESHOLD=0.10

# Defamation-safe language layer
DEFAMATION_MODE=standard
DEFAMATION_DEFAULT_LABEL=UNVERIFIED
DEFAMATION_MIN_CONFIDENCE_TO_SHOW_NAME=0.70
CORRECTION_REQUEST_RETENTION_DAYS=365
NOTIFY_ON_CORRECTION_EMAIL=
RATE_LIMIT_CORRECTION_REQUESTS_PER_TARGET_PER_MONTH=3

# Right-to-Respond feedback
FEEDBACK_TOKEN_EXPIRY_HOURS=48
FEEDBACK_MAX_ATTACHMENTS=5
FEEDBACK_MAX_ATTACHMENT_SIZE_MB=10
FEEDBACK_ATTACHMENT_TOTAL_LIMIT_MB=25
FEEDBACK_RATE_LIMIT_PER_CONTACT_PER_MONTH=3
FEEDBACK_WHITELISTED_DOMAINS=
FEEDBACK_AUTO_VERIFY_DOMAINS=
FEEDBACK_PUBLIC_DISPLAY_DELAY_SECONDS=0
FEEDBACK_EMAIL_FROM=noreply@justice-tracker.local
FEEDBACK_WEBHOOK_URL=
FEEDBACK_ENABLE_CAPTCHA_FOR_ANONYMOUS=false
FEEDBACK_ENABLE_OAUTH_VERIFICATION=false

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
